# Required for TTS (use Agent Plan key for correct billing)
VOLCENGINE_AGENT_PLAN_KEY=your_volcengine_agent_plan_key_here
# Fallback (if Agent Plan key not available):
# VOLCENGINE_TTS_KEY=your_volcengine_generic_tts_key_here

# Optional for LLM translation (if not set, use manual Chinese script editing)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Server port (default: 8000)
PORT=8000
